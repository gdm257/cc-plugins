{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "cc-257",
  "description": "Directory of popular Claude Code extensions including development tools, productivity plugins, and MCP integrations",
  "owner": {
    "name": "gdm257",
    "email": "gdm@disroot.org"
  },
  "plugins": [
    {
      "name": "agent-skills",
      "description": "Best practice of agent skills",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/agent-skills",
      "category": "development"
    },
    {
      "name": "openspec-claude-skills",
      "description": "openspec skills for claude",
      "version": "1.3.1",
      "source": "./plugins/openspec-claude-skills",
      "category": "development"
    },
    {
      "name": "openspec-openspec-skills",
      "version": "1.3.1",
      "description": "openspec skills for opencode",
      "source": "./plugins/openspec-openspec-skills",
      "category": "development"
    },
    {
      "name": "php-lsp-bunx",
      "description": "PHP language server (Intelephense) for code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/php-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "intelephense": {
          "command": "bunx",
          "args": ["intelephense", "--stdio"],
          "extensionToLanguage": {
            ".php": "php"
          }
        }
      }
    },
    {
      "name": "php-lsp-npx",
      "description": "PHP language server (Intelephense) for code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/php-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "intelephense": {
          "command": "npx",
          "args": ["intelephense", "--stdio"],
          "extensionToLanguage": {
            ".php": "php"
          }
        }
      }
    },
    {
      "name": "pyright-lsp-uvx",
      "description": "Python language server (Pyright) for type checking and code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/pyright-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "pyright": {
          "command": "uvx",
          "args": ["pyright-langserver", "--stdio"],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    },
    {
      "name": "pyright-lsp-pipx",
      "description": "Python language server (Pyright) for type checking and code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/pyright-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "pyright": {
          "command": "pipx",
          "args": ["run", "pyright-langserver", "--stdio"],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    },
    {
      "name": "powershell-lsp",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/powershell-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "powershell": {
          "command": "pwsh",
          "args": [
            "-NoLogo",
            "-NoProfile",
            "-Command",
            "Start-EditorServices -HostName 'Claude Code' -HostProfileId 'ClaudeCode' -HostVersion '1.0.0' -Stdio -LogPath '/dev/null' -LogLevel 'None' -EnableConsoleRepl"
          ],
          "extensionToLanguage": {
            ".ps1": "powershell",
            ".psm1": "powershell",
            ".psd1": "powershell"
          },
          "transport": "stdio",
          "maxRestarts": 3
        }
      }
    },
    {
      "name": "ruby-lsp",
      "description": "Ruby language server for code intelligence and analysis",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/ruby-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "ruby-lsp": {
          "command": "ruby-lsp",
          "extensionToLanguage": {
            ".rb": "ruby",
            ".rake": "ruby",
            ".gemspec": "ruby",
            ".ru": "ruby",
            ".erb": "erb"
          }
        }
      }
    },
    {
      "name": "ruby-lsp-gem-exec",
      "description": "Ruby language server for code intelligence and analysis",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/ruby-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "ruby-lsp": {
          "command": "gem",
          "args": ["exec", "ruby-lsp"],
          "extensionToLanguage": {
            ".rb": "ruby",
            ".rake": "ruby",
            ".gemspec": "ruby",
            ".ru": "ruby",
            ".erb": "erb"
          }
        }
      }
    },
    {
      "name": "ty-lsp",
      "description": "Python language server (ty) for type checking (mypy) and code intelligence (pyright)",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/ty-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "ty": {
          "command": "ty",
          "args": ["server"],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    },
    {
      "name": "ty-lsp-uvx",
      "description": "Python language server (ty) for type checking (mypy) and code intelligence (pyright)",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/ty-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "ty": {
          "command": "uvx",
          "args": ["ty", "server"],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    },
    {
      "name": "ty-lsp-pipx",
      "description": "Python language server (ty) for type checking (mypy) and code intelligence (pyright)",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/ty-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "ty": {
          "command": "pipx",
          "args": ["run", "ty", "server"],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    },
    {
      "name": "typescript-lsp-bunx",
      "description": "TypeScript/JavaScript language server for enhanced code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/typescript-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "bunx",
          "args": [
            "-p",
            "typescript",
            "-p",
            "typescript-language-server",
            "typescript-language-server",
            "--stdio"
          ],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mts": "typescript",
            ".cts": "typescript",
            ".mjs": "javascript",
            ".cjs": "javascript"
          }
        }
      }
    },
    {
      "name": "typescript-lsp-npx",
      "description": "TypeScript/JavaScript language server for enhanced code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "gdm257",
        "email": "gdm@disroot.org"
      },
      "source": "./plugins/typescript-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "npx",
          "args": [
            "--package",
            "typescript",
            "--package",
            "typescript-language-server",
            "typescript-language-server",
            "--stdio"
          ],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mts": "typescript",
            ".cts": "typescript",
            ".mjs": "javascript",
            ".cjs": "javascript"
          }
        }
      }
    }
  ]
}
